# ============================================================
# 澶囪鎼瓙 / Lesson Agent Platform
# Copy this file to .env and replace every replace-* value.
# Never commit the real .env file.
# ============================================================

# ---------- Shared model credentials ----------
# F1 and F2 Engine
DEEPSEEK_API_KEY=replace-with-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# F3 uses OpenAI-compatible variable names. Usually use the same DeepSeek key.
API_KEY=replace-with-your-deepseek-key
BASE_URL=https://api.deepseek.com/v1
MODEL=deepseek-flash
F3_MODEL_MODE=REAL
F3_STORAGE_ROOT=runtime/f3_sessions
CLASSROOM_TIMEOUT_SECONDS=15
MAX_CONSECUTIVE_TIMEOUT_ACTIONS=3

# F4 uses its own variable names. Usually use the same DeepSeek key.
LLM_API_KEY=replace-with-your-deepseek-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=45
LLM_EXTRA_BODY={"thinking":{"type":"disabled"},"max_tokens":2048}
LLM_PROVIDER=deepseek
SUGGESTION_PROVIDER=generic_llm

# ---------- F2 Python Engine ----------
# Must be identical in the Python Engine and Spring Boot processes.
ENGINE_INTERNAL_TOKEN=replace-with-at-least-32-random-characters
PAPER4_BIND_HOST=127.0.0.1
PAPER4_BIND_PORT=8001

# ---------- F2 Spring Boot / MySQL ----------
DB_URL=jdbc:mysql://127.0.0.1:3306/lesoongen?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
DB_USERNAME=lesoongen
DB_PASSWORD=replace-with-your-mysql-password
SERVER_PORT=8080
FRONTEND_ORIGIN=http://127.0.0.1:5177
LESSONGEN_RUNTIME_KIND=release

# Internal service addresses. Keep loopback addresses unless services are split
# across machines.
ENGINE_BASE_URL=http://127.0.0.1:8001
APP_F1_BASE_URL=http://127.0.0.1:8002
PLATFORM_F3_BASE_URL=http://127.0.0.1:8003
PLATFORM_F4_BASE_URL=http://127.0.0.1:8000
PLATFORM_F2_SELF_URL=http://127.0.0.1:8080

# ---------- F4 local service ----------
DATABASE_URL=sqlite:///./pedago_loop.db
AUTH_PROVIDER=development
DEVELOPMENT_USERNAME=development
CONTEXT_CONTRIBUTORS=["lesson_context","session_memory","knowledge_retrieval","case_retrieval"]
MAX_CONTEXT_TOKENS=96000
MEMORY_PROVIDER=rule_based
CASE_RETRIEVER=metadata
KNOWLEDGE_RETRIEVER=metadata
RETRIEVAL_TOP_K=3
SECTION_PARSER=bounded_v2
REVISION_STRATEGY=replace_or_append_v2

