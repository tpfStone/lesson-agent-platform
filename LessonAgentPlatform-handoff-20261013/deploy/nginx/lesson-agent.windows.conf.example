# Render with windows-entry.ps1; paths use forward slashes on Windows.
# This is a local HTTP development entry, not an Internet/HTTPS deployment.
worker_processes 1;
daemon off;
master_process on;
pid logs/lesson-agent.pid;
error_log logs/error.log notice;

events {
    worker_connections 256;
}

http {
    include "__NGINX_HOME__/conf/mime.types";
    default_type application/octet-stream;
    access_log logs/access.log;
    client_body_temp_path temp/client_body_temp;
    proxy_temp_path temp/proxy_temp;
    keepalive_timeout 65;

    server {
        listen 127.0.0.1:__LISTEN_PORT__;
        server_name 127.0.0.1 localhost;
        root "__FRONTEND_DIST__";
        index index.html;

        # The application enforces a 20 MiB file limit. Leave room for multipart framing.
        client_max_body_size 22m;
        client_body_timeout 60s;

        location /api/ {
            proxy_pass http://127.0.0.1:__BACKEND_PORT__;
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout 5s;
            proxy_send_timeout __PROXY_READ_TIMEOUT_SECONDS__s;
            proxy_read_timeout __PROXY_READ_TIMEOUT_SECONDS__s;
        }

        # A missing JavaScript/CSS asset must not return index.html.
        location /assets/ {
            try_files $uri =404;
        }

        location / {
            try_files $uri $uri/ /index.html;
        }
    }
}
