      "ordered": null,
      "tableRows": [],
      "teachingProcess": null
    },
    {
      "id": "b2",
      "text": "五年级上册 · 1课时 · 40分钟",
      "type": "paragraph",
      "items": [],
      "level": null,
      "ordered": null,
      "tableRows": [],
      "teachingProcess": null
    },
    {
      "id": "b3",
