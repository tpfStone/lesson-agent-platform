{
  "name": "lesoongen-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && node scripts/test-e2e.mjs",
    "audit:ui": "npm run build && node scripts/capture-ui.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint . --max-warnings=0",
    "lint:openapi": "redocly lint ../specs/001-lesson-plan-web/contracts/openapi.yaml",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "axios": "^1.12.2",
    "element-plus": "^2.11.4",
    "js-sha256": "^1.0.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.55.1",
    "@redocly/cli": "^2.52.0",
    "@types/node": "^24.5.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "2.4.6",
    "eslint": "^9.36.0",
    "eslint-plugin-vue": "^10.5.0",
    "jsdom": "^27.0.0",
    "msw": "^2.11.3",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.44.1",
    "vite": "^7.1.7",
    "vitest": "^5.0.0",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.0.8"
  }
}
