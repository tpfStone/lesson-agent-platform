{
  "contract_version": "p1-engine-v1",
  "models": {
    "CreateRunRequest": {
      "$defs": {
        "EngineLessonInput": {
          "additionalProperties": false,
          "properties": {
            "additional_requirements": {
              "default": "",
              "maxLength": 8000,
              "title": "Additional Requirements",
              "type": "string"
            },
            "available_resources": {
              "items": {
                "type": "string"
              },
              "maxItems": 50,
              "title": "Available Resources",
              "type": "array"
            },
            "class_size": {
              "anyOf": [
                {
                  "maximum": 200,
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Class Size"
            },
            "course_information": {
              "default": "",
              "maxLength": 4000,
              "title": "Course Information",
              "type": "string"
            },
            "curriculum_standards": {
              "items": {
                "type": "string"
              },
              "maxItems": 50,
              "title": "Curriculum Standards",
              "type": "array"
            },
            "detail_level": {
              "default": "showcase",
              "enum": [
                "standard",
                "showcase"
              ],
              "title": "Detail Level",
              "type": "string"
            },
            "duration_minutes": {
              "default": 45,
              "maximum": 240,
              "minimum": 5,
              "title": "Duration Minutes",
              "type": "integer"
            },
            "grade": {
              "maxLength": 64,
              "minLength": 1,
              "title": "Grade",
              "type": "string"
            },
            "learning_objectives": {
              "items": {
                "type": "string"
              },
              "maxItems": 20,
              "title": "Learning Objectives",
              "type": "array"
            },
            "lesson_style": {
              "default": "choose_the_best_fit_for_this_topic",
              "title": "Lesson Style",
              "type": "string"
            },
            "mode": {
              "$ref": "#/$defs/EngineMode"
            },
            "must_preserve_content": {
              "items": {
                "type": "string"
              },
              "maxItems": 20,
              "title": "Must Preserve Content",
              "type": "array"
            },
            "optimization_focus": {
              "items": {
                "type": "string"
              },
              "maxItems": 20,
              "title": "Optimization Focus",
              "type": "array"
            },
            "student_profile": {
              "default": "",
              "maxLength": 8000,
              "title": "Student Profile",
              "type": "string"
            },
            "subject": {
              "maxLength": 64,
              "minLength": 1,
              "title": "Subject",
              "type": "string"
            },
            "textbook_content": {
              "default": "",
              "maxLength": 30000,
              "title": "Textbook Content",
              "type": "string"
            },
            "textbook_version": {
              "default": "",
              "maxLength": 255,
              "title": "Textbook Version",
              "type": "string"
            },
            "topic": {
              "maxLength": 255,
              "minLength": 1,
              "title": "Topic",
              "type": "string"
            }
          },
          "required": [
            "mode",
            "subject",
            "grade",
            "topic"
          ],
          "title": "EngineLessonInput",
          "type": "object"
        },
        "EngineMode": {
          "enum": [
            "generate",
            "optimize"
          ],
          "title": "EngineMode",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "1",
          "default": "1",
          "title": "Contract Version",
          "type": "string"
        },
        "external_job_id": {
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
          "title": "External Job Id",
          "type": "string"
        },
        "request_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Request Sha256",
          "type": "string"
        },
        "task": {
          "$ref": "#/$defs/EngineLessonInput"
        }
      },
      "required": [
        "external_job_id",
        "request_sha256",
        "task"
      ],
      "title": "CreateRunRequest",
      "type": "object"
    },
