# SimClass MVP 环境配置示例（复制为 .env 后填写，不要把真实 key 提交到仓库）

# 示例: Groq（OpenAI 兼容端点）
# API_KEY=gsk-your-groq-key
# BASE_URL=https://api.groq.com/openai/v1
# MODEL=qwen/qwen3.8-27b   # 模型 ID 以 GET {BASE_URL}/models 返回为准

# 示例: OpenAI
API_KEY=sk-your-api-key
BASE_URL=https://api.openai.com/v1
MODEL=gpt-4o-mini

# --- 课堂自主推进 (Timeout τ) ---
# 用户静默 τ 秒后触发 timeout，课堂自主继续（开发时可设 5）
CLASSROOM_TIMEOUT_SECONDS=15
# 连续 timeout 自主推进的安全上限，达到后暂停并等待用户输入
MAX_CONSECUTIVE_TIMEOUT_ACTIONS=3

# --- F3 Formal API ---
# 未显式传 modelMode 时的服务端默认值: REAL / MOCK
F3_MODEL_MODE=MOCK
# Session/Event/Result 持久化目录（相对项目根目录）
F3_STORAGE_ROOT=runtime/f3_sessions
# 正式 F3 API 固定建议端口 8003（启动命令中指定）
