# Professor demo: DeepSeek via the replaceable generic provider.
DATABASE_URL=sqlite:///./pedago_loop.db
# DATABASE_URL=postgresql+psycopg://pedago:pedago@localhost:5432/pedago_loop
SUGGESTION_PROVIDER=generic_llm
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=45
LLM_EXTRA_BODY={"thinking":{"type":"disabled"},"max_tokens":2048}
LLM_PROVIDER=deepseek
AUTH_PROVIDER=development
DEVELOPMENT_USERNAME=development
CONTEXT_CONTRIBUTORS=["lesson_context","session_memory","knowledge_retrieval","case_retrieval"]
MAX_CONTEXT_TOKENS=12000
MEMORY_PROVIDER=rule_based
CASE_RETRIEVER=metadata
KNOWLEDGE_RETRIEVER=metadata
RETRIEVAL_TOP_K=3
SECTION_PARSER=bounded_v2
REVISION_STRATEGY=replace_or_append_v2
